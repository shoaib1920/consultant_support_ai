# ---- Core ----
# Long random string used to sign session cookies and file URLs (required in production)
SESSION_SECRET=change-me-to-a-64-char-random-string
# Key for encrypting stored documents (required in production). NEVER change it later: old files become unreadable.
STORAGE_ENCRYPTION_KEY=change-me
# Only the exact value "true" turns on the demo: role-picker login, demo banner, demo data. Leave unset for real clients.
DEMO_MODE=
# Demo deployment only: where "Start free trial" should go (the live app's sign-up page), e.g. https://app.example.com/signup
SIGNUP_URL=
# Secret for the nightly re-assessment job (Vercel Cron sends it automatically when set in Vercel)
CRON_SECRET=

# ---- AI (set ONE key; leave both blank to use the MOCK AI adapter) ----
# Google Gemini: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Anthropic Claude (paid). If both keys are set, Claude is used unless AI_PROVIDER=gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_PROVIDER=
# Max AI calls per user per minute
AI_RATE_LIMIT_PER_MINUTE=10
# Quota guard for the shared key (blank = defaults; Gemini: 8 per minute, 200 per day; Claude: 40 per minute, no daily cap).
# The nightly re-check uses at most 60% of the daily allowance so staff always keep some.
AI_PROVIDER_RPM=
AI_DAILY_LIMIT=

# ---- Firebase (leave blank to use the in-memory/JSON-file MOCK datastore + mock auth) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Service account JSON (single line) for firebase-admin on the server
FIREBASE_SERVICE_ACCOUNT_JSON=

# File storage: firestore (default with Firebase, works on free Spark plan) | firebase (Firebase Storage, Blaze plan) | local (mock)
FILE_STORAGE=
