{
  "name": "visaguard-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=lib/index.js --tsconfig=../tsconfig.json --external:firebase-admin --external:firebase-functions --external:@anthropic-ai/sdk --external:pdf-lib",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "pdf-lib": "1.17.1",
    "zod": "4.6.7"
  },
  "devDependencies": { "esbuild": "0.25.10", "typescript": "5.9.3" }
}
